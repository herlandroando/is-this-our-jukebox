# ========================================================
# 🎵 IsThisOurJukebox V2 — Configuration (.env)
# ========================================================

# The local port that the Jukebox server listens on (default: 3000)
JUKEBOX_PORT=3000

# Tunnel Mode: "named" | "quick" | "off"
# - "named": Uses your permanent custom domain managed in Cloudflare (e.g. jukebox.yourdomain.com)
# - "quick": Uses a temporary zero-account *.trycloudflare.com URL
# - "off": Pure local LAN mode (default)
TUNNEL_MODE=quick

# [Named Tunnel Mode] Your public domain configured in Cloudflare Zero Trust:
# PUBLIC_URL=https://jukebox.yourdomain.com

# [Named Tunnel Mode] Optional connector token if running named tunnel via `bun run tunnel --named`:
# CLOUDFLARE_TUNNEL_TOKEN=eyJh...

# Bandwidth Saver / Upload Protection:
# Set to "false" to restrict remote coworkers to Controller-Only mode (search, queue, upvote, lyrics, reactions).
# This prevents remote headphone audio from consuming the host machine's internet upload bandwidth.
# Set to "true" to allow remote headphone audio ("Tune In / Silent Disco").
# Default: true (Host DJ can also toggle this live inside Host Studio!)
ALLOW_REMOTE_AUDIO=true
